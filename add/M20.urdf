    <!-- Gazebo Plugin -->
    <gazebo>
        <static>false</static>
        <gravity>true</gravity>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>/home/cxz/ros2_ws/install/m20_description/share/m20_description/config/m20_controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- 轮胎摩擦参数配置，彻底解决滑动、打滑问题 -->
    <!-- 左前轮摩擦力配置（优化版） -->
    <gazebo reference="fl_wheel">
        <!-- 核心1：摩擦系数（1.0-3.0是真实橡胶轮胎的范围，不是越大越好！） -->
        <mu1>2.5</mu1>  <!-- 纵向摩擦系数（前后方向） -->
        <mu2>2.5</mu2>  <!-- 侧向摩擦系数（左右方向） -->
        <fdir1>1 0 0</fdir1> <!-- 摩擦方向：沿轮子前进方向（X轴） -->
        
        <surface>
            <friction>
            <ode>
                <!-- 核心2：滑动系数（0.01-0.1比较真实，允许微小滑动，避免抖动） -->
                <slip1>0.02</slip1>
                <slip2>0.02</slip2>
                <!-- 核心3：滚动摩擦（0.1-0.5，让轮子停下来更自然） -->
                <rolling_friction>0.3</rolling_friction>
            </ode>
            </friction>
            
            <!-- 核心4：接触参数（确保轮子和地面充分接触） -->
            <contact>
            <ode>
                <min_depth>0.002</min_depth> <!-- 最小穿透深度（太小会飘，太大会卡） -->
                <max_vel>0.1</max_vel>     <!-- 最大接触速度 -->
            </ode>
            </contact>
        </surface>
    </gazebo>

    <!-- 右前轮（和左前一样） -->
    <gazebo reference="fr_wheel">
        <mu1>2.5</mu1>
        <mu2>2.5</mu2>
        <fdir1>1 0 0</fdir1>
        <surface>
            <friction>
            <ode>
                <slip1>0.02</slip1>
                <slip2>0.02</slip2>
                <rolling_friction>0.3</rolling_friction>
            </ode>
            </friction>
            <contact>
            <ode>
                <min_depth>0.002</min_depth>
                <max_vel>0.1</max_vel>
            </ode>
            </contact>
        </surface>
    </gazebo>

    <!-- 左后轮（和左前一样） -->
    <gazebo reference="hl_wheel">
        <mu1>2.5</mu1>
        <mu2>2.5</mu2>
        <fdir1>1 0 0</fdir1>
        <surface>
            <friction>
